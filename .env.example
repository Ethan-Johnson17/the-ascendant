# Copy this file to `.env.local` and fill in the values.
# `.env.local` is ignored by Git, so your keys never get committed.
#
# Only variables starting with VITE_ are sent to the browser.
# NEVER put an AI provider key or the Supabase service-role key in a VITE_ variable.

# Supabase project URL (https://<project>.supabase.co, nothing after it) and the
# PUBLISHABLE key (sb_publishable_...; Project Settings -> API Keys). Safe for the browser:
# Row Level Security in the database is what protects player data.
# Older projects call it the "anon" key: VITE_SUPABASE_ANON_KEY is still accepted.
# NEVER use the secret key (sb_secret_...) or the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# How AI-backed features behave in this build:
#   fixtures - deterministic, clearly labelled development responses (no AI calls, free)
#   live     - calls the server-side AI orchestration functions
VITE_AI_MODE=fixtures
